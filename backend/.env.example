# Backend API Configuration
APP_NAME="AI Database Engineer API"
APP_VERSION="0.1.0"
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# PostgreSQL - Connexion données immobilières (lecture seule)
# Utilise le rôle analyst_ro pour lire les données DVF et INSEE
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=immo
POSTGRES_USER_RO=analyst_ro
POSTGRES_PASSWORD_RO=a_remplacer

# PostgreSQL - Connexion données applicatives (futures)
# Pour l'authentification, utilisateurs, historique (à configurer plus tard)
# APP_DB_HOST=db
# APP_DB_PORT=5432
# APP_DB_NAME=app_data
# APP_DB_USER=app_user
# APP_DB_PASSWORD=a_remplacer

# Sécurité (pour authentification JWT - Phase 3.2+)
# SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO
