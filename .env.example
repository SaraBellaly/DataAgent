# Copier ce fichier en .env et remplacer les valeurs.
# Ne jamais versionner .env.

# Superutilisateur technique (compte d'initialisation du cluster).
# Sert uniquement à créer l'extension, les rôles et les schémas (sql/00, sql/01).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=a_remplacer
POSTGRES_DB=immo

# Port exposé sur la machine hôte (lié à 127.0.0.1 uniquement)
POSTGRES_PORT=5432

# Propriétaire des schémas immo et immo_staging, sans superutilisateur,
# avec pg_read_server_files pour COPY depuis data/raw (droit sensible, cf. docs/securite.md)
IMMO_ADMIN_PASSWORD=a_remplacer

# Rôle lecture seule utilisé par l'agent
ANALYST_RO_PASSWORD=a_remplacer

# Rôle de l'application : comptes, sessions et historique (schéma app uniquement)
APP_AGENT_PASSWORD=a_remplacer
